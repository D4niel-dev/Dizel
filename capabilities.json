      "tui": "/session new",
      "gui": "Ctrl+N"
    },
    {
      "id": "chat.copy",
      "name": "Copy a reply",
      "tui": "/export",
      "gui": "Copy button"
    },
    {
      "id": "chat.feedback",
      "name": "Rate a reply",
      "tui": null,
      "gui": "Thumb up/down"
    },
    {
