      "name": "New line without sending",
      "tui": "Ctrl+Y",
      "gui": "Shift+Enter"
    },
    {
      "id": "chat.stop",
      "name": "Stop generating",
      "tui": "Ctrl+C",
      "gui": "Stop button"
    },
    {
      "id": "chat.new",
